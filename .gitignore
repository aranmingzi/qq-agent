# ============================================================
# QQ Agent .gitignore
# 原则：仓库只放「架构本身」——源码、UI、文档、测试、工具链。
# 模型权重、虚拟环境、运行时数据、密钥一律不入库。
# ============================================================

# ---------- 依赖 ----------
node_modules/
console/node_modules/

# ---------- 模型权重 / 虚拟环境 / 打包产物（合计约 50GB）----------
rvc/
gpt-sovits-app/
gpt-sovits-download/
gpt-sovits-models/
svc/
seed-vc/
ddsp-svc/
diffsinger-env/
diffsinger-hutao/
_package/
_wheels/
# 阶段 1 的 IndexTTS 隔离实验环境（15.8GB：python venv + 5.2GB 模型 + 试听音频）。
# 它没有接入 src/，删掉就回到原状；结论见 docs/语音-IndexTTS-阶段1实测-2026-10-30.md
_indextts/

# ---------- 运行时产物（唱歌/翻唱的中间件与成品）----------
cache/
out/
work/
songs/
background_music/

# ---------- 媒体与模型文件：二进制大件一律不入库 ----------
*.wav
*.m4a
*.mp3
*.flac
*.ogg
*.pth
*.pt
*.onnx
*.ckpt
*.safetensors
*.whl
*.zip
*.7z
*.tar.gz
*.part[0-9]*
*.bin

# ---------- 🔴 运行时数据：聊天记录 / 会话留档 / 记忆 / 语音 ----------
# 只放行一份干净模板，其余全部留在本地
data/*
!data/config.example.json
!data/.gitkeep

# ---------- 知识库（本地数据，不入库）----------
data/knowledge/

# ---------- 协议端登录态 ----------
snowluma/
qrcode-login.png
/qqagent-qr-*.png
/QQ二维码*.png

# ---------- 🔴 敏感配置与密钥 ----------
# data/config.json 含 API Key，由上面 data/* 规则挡住
.env
.env.*
.deploy/
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
*_ed25519

# ---------- DSH 任务产物与本地工作区 ----------
dsh-work/
workspace/

# ---------- 备份 / 临时 / 编辑器 ----------
*.bak
*.bak-*
*.orig
*.tmp
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---------- 构建产物 ----------
dist/
dist-portable/
dist-installer/
build/

# ---------- 第三方源码转储 / 本地备份 / 抓包样本（不入库）----------
_bench/
_backup/
_vendor/
zip_inspect/
_notes/

# ---------- 协议端安装包分片与临时压缩包 ----------
NapCat.Shell.*
*.tar.gz
*.tgz
qqagent-*.log
qqagent-qr-*.png
qqagent-qr-now*.png

# ---------- 根目录散落的临时验证脚本 ----------
/test-cover*.mjs
/test-incoming-song.mjs
/test-melody-auto.mjs
/test-new-song-cover.mjs
/test-queue.mjs
/test-router.mjs
/test-sing-melody.mjs
/test-sing-vc.mjs
/test-song-auto.mjs
/test-song-flow.mjs
/test-video-frame.mjs
/verify_rvc_chain.mjs
/gen_emotions.mjs
/一键翻唱.cmd
/启动QQagent.bat
/HANDOVER-*.md
# 发布用临时目录
dist-github/
